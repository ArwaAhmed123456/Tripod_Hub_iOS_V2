{
  "expo": {
    "name": "Tripod Services",
    "slug": "signinapp-enterprise-mobile",
    "scheme": "tripodservices",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Professional visitor management companion app for Tripod Services",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haalim.tripodservices",
      "buildNumber": "1.1.1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to take visitor and delivery photos for verification.",
        "NSPhotoLibraryUsageDescription": "Photo library is used to select delivery and cargo pictures.",
        "NSMicrophoneUsageDescription": "Microphone access for voice features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.haalim.tripodservices",
      "versionCode": 15,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tripod-signin-app.onrender.com/api",
      "webAppUrl": "https://tripod-signin-app.onrender.com",
      "eas": {
        "projectId": "995ac383-70e8-4f81-b6e1-8ff63b77a8a9"
      }
    },
    "owner": "hayat123a",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/995ac383-70e8-4f81-b6e1-8ff63b77a8a9"
    }
  }
}
